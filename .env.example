# Public Supabase project URL used by browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anon key. Safe for client bundles, still governed by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key. Never expose to client code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret for future short-lived QR signing tokens. Use at least 32 random characters.
QR_SIGNING_SECRET=

# Optional fictional bootstrap admin identity for local/demo setup.
ADMIN_LOGIN_EMAIL=
ADMIN_LOGIN_USERNAME=
ADMIN_LOGIN_PASSWORD=
